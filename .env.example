# ReplyIQ root environment template (R12).
# Copy to .env for local development. Per-app templates live in
# apps/api/.env.example and apps/web/.env.example - the API validates every
# variable below at boot (see apps/api/src/config/env.validation.ts).

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://replyiq:replyiq_dev_password@localhost:5432/replyiq?schema=public"

# --- API server -------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Networking / security --------------------------------------------------
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=10
VERIFICATION_RATE_LIMIT_MAX=5

# --- Domain verification & Test Mode ----------------------------------------
# Enables the DEV_BYPASS verification method for CI and local development.
# Honoured ONLY when NODE_ENV is not "production" - and a production process
# with this set to "true" refuses to start (see FR-TEST-10). Anything other
# than the exact string "true" means disabled: the gate fails closed.
ALLOW_DEV_VERIFICATION_BYPASS=false

# Optional extra sandbox namespace you provably control, e.g.
# "sandbox.replyiq.app". Leave empty to allow only IANA-reserved test names
# (*.test, *.example, example.com, *.invalid, *.localhost, *.local, *.internal).
# A bare TLD here is ignored, so this cannot widen the boundary by accident.
SANDBOX_DOMAIN_SUFFIX=

# Per-organization limits on the two abuse-sensitive domain routes. The tenant,
# not the IP, is the abuse boundary for endpoints that make outbound requests.
DOMAIN_RATE_LIMIT_TTL=3600
DOMAIN_ADD_RATE_LIMIT_MAX=10
DOMAIN_VERIFY_RATE_LIMIT_MAX=20

# --- Knowledge ingestion -----------------------------------------------------
# One ingest request fans out into a dozen outbound fetches against a third
# party's server, so it is the most abusable endpoint in the product - and the
# politeness limit matters as much as the abuse limit. Per organization.
KNOWLEDGE_INGEST_TTL=3600
KNOWLEDGE_INGEST_MAX=5

# --- Transactional email -----------------------------------------------------
# "log" prints messages to stdout instead of sending them - which is how you
# read the password reset link locally.
#
# "resend"  needs a sending domain you control. Branded and scales, but it
#           delivers only to your own account address until a domain is
#           verified, so it cannot serve real users on its own.
# "smtp"    needs no domain at all. Any mailbox with an app password reaches
#           real recipients (Gmail: smtp.gmail.com:587, App Password required).
EMAIL_TRANSPORT=log

# EMAIL_TRANSPORT=resend
RESEND_API_KEY=

# EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sender address. Required by both real transports.
EMAIL_FROM=

# Public origin of the dashboard, used to build links inside emails.
WEB_URL=http://localhost:5173
