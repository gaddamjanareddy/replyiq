PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/replyiq?schema=public"
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=10
VERIFICATION_RATE_LIMIT_MAX=5
ALLOW_DEV_VERIFICATION_BYPASS=false
SANDBOX_DOMAIN_SUFFIX=
DOMAIN_RATE_LIMIT_TTL=3600
DOMAIN_ADD_RATE_LIMIT_MAX=10
DOMAIN_VERIFY_RATE_LIMIT_MAX=20

# --- Transactional email -----------------------------------------------------
# "log" prints messages to stdout instead of sending them - which is how you
# read the password reset link locally.
#
# "resend"  needs a sending domain you control. Branded and scales, but it
#           delivers only to your own account address until a domain is
#           verified, so it cannot serve real users on its own.
# "smtp"    needs no domain at all. Any mailbox with an app password reaches
#           real recipients (Gmail: smtp.gmail.com:587, App Password required).
EMAIL_TRANSPORT=log

# EMAIL_TRANSPORT=resend
RESEND_API_KEY=

# EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sender address. Required by both real transports.
EMAIL_FROM=

# Public origin of the dashboard, used to build links inside emails.
WEB_URL=http://localhost:5173
