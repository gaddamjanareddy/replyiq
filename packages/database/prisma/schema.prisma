generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum BusinessDomainStatus {
  PENDING
  VERIFIED
  DISABLED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  DOMAIN_PENDING
  COMPLETED
}

/// How ownership of a BusinessDomain was proven.
///
/// DNS_TXT / HTML_META are the two live methods: both require a real network
/// check against infrastructure only the domain's operator controls.
///
/// SANDBOX is Test Mode. It performs no network check, and is accepted ONLY for
/// hostnames in IANA-reserved namespaces that nobody can register (see
/// common/security/sandbox-domains.ts). It is available in production because
/// it grants no authority over any real name.
///
/// DEV_BYPASS is a non-production-only affordance for CI, gated at process boot
/// (see config/verification-methods.ts). It is not a member of the accepted
/// request enum unless the boot gate opened.
enum VerificationMethod {
  DNS_TXT
  HTML_META
  SANDBOX
  DEV_BYPASS
}

/// Where a piece of knowledge came from.
///
/// SITE_PAGE is the differentiator: because the business proved it controls the
/// domain, we are entitled to read that site and build the knowledge base
/// before the owner has done anything. Every competitor's onboarding starts
/// with "now upload some documents", which is where trials die.
enum KnowledgeSourceType {
  SITE_PAGE
  FAQ
  DOCUMENT
}

enum KnowledgeSourceStatus {
  /// Queued; the crawl has not reached it yet.
  PENDING
  /// Being fetched right now.
  FETCHING
  /// Usable.
  READY
  /// Fetch or extraction failed. `failureReason` says why, in words the owner
  /// can act on.
  FAILED
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(150)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  users      User[]
  businesses Business[]

  @@index([status])
  @@map("organizations")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  name           String     @db.VarChar(150)
  email          String     @db.VarChar(320)
  passwordHash   String     @db.VarChar(255)
  role           UserRole   @default(MANAGER)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@unique([email])
  @@index([organizationId])
  @@index([status])
  @@map("users")
}

model Business {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  name             String           @db.VarChar(200)
  industry         String?          @db.VarChar(100)
  description      String?          @db.Text
  websiteUrl       String?          @db.VarChar(500)
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  status           BusinessStatus   @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receptionistQuestions ReceptionistQuestion[]
  domains               BusinessDomain[]
  knowledgeSources      KnowledgeSource[]
  onboardingProgress    OnboardingProgress?

  @@index([organizationId])
  @@index([status])
  @@index([onboardingStatus])
  @@map("businesses")
}

model BusinessDomain {
  id                 String               @id @default(uuid()) @db.Uuid
  businessId         String               @db.Uuid
  domain             String               @db.VarChar(255)
  isPrimary          Boolean              @default(false)
  status             BusinessDomainStatus @default(PENDING)
  verifiedAt         DateTime?
  verificationToken  String?              @db.VarChar(255)
  verificationMethod VerificationMethod?

  /// True when `domain` sits in an IANA-reserved namespace that cannot be
  /// registered by anyone (*.test, *.example, example.com, *.invalid,
  /// *.localhost, *.local, *.internal) or the deployment's configured sandbox
  /// suffix. Decided once at creation from the hostname alone and immutable
  /// thereafter, because domain strings are not editable (FR-DOM-14).
  ///
  /// This single flag is the entire Test Mode security boundary:
  ///   isSandbox = true  -> only SANDBOX verification is accepted
  ///   isSandbox = false -> only DNS_TXT / HTML_META are accepted
  /// and the widget layer (M7) MUST refuse to serve live traffic when true.
  isSandbox Boolean @default(false)

  /// Timestamp of the most recent verification attempt, successful or not.
  /// Powers "last checked" in the UI and rate-limit telemetry.
  lastCheckedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // D-02: uniqueness is enforced by a hand-maintained PARTIAL unique index
  // (migration 20260822000000_domain_partial_unique):
  //   CREATE UNIQUE INDEX business_domains_domain_active_key
  //     ON business_domains(domain) WHERE "deletedAt" IS NULL;
  // Prisma DSL cannot express partial indexes, so there is intentionally NO
  // @@unique([domain]) here. Do not reintroduce it - a full-table unique
  // index would permanently block re-registration of soft-deleted names.
  @@index([businessId])
  @@index([status])
  @@index([businessId, status, deletedAt])
  @@map("business_domains")
}

/// Append-only record of security- and ownership-relevant events.
///
/// Written on a best-effort basis: an audit failure is logged but never fails
/// the user's request, because losing an audit line is preferable to failing a
/// verification the user legitimately completed. Rows are never updated or
/// deleted by application code.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Actor context. Nullable because some events (future: system jobs) have no
  /// human actor, and because a deleted user must not cascade away the record.
  organizationId String? @db.Uuid
  userId         String? @db.Uuid
  businessId     String? @db.Uuid

  /// Dotted event name, e.g. "domain.verified", "domain.dev_bypass_used".
  event        String  @db.VarChar(100)
  resourceType String? @db.VarChar(50)
  resourceId   String? @db.Uuid

  /// Event-specific detail. Must never contain secrets - notably never the
  /// verification token.
  metadata Json?

  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([businessId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}

/// A place knowledge came from: one page of the verified site, or the owner
/// writing an answer by hand.
model KnowledgeSource {
  id         String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid

  /// Which verified domain this was read from. Null for hand-written FAQs.
  /// Kept so that removing a domain can archive what it taught us.
  domainId String? @db.Uuid

  type   KnowledgeSourceType
  status KnowledgeSourceStatus @default(PENDING)

  /// Absolute URL for SITE_PAGE. Null for FAQ.
  url   String? @db.VarChar(2048)
  /// Page title, or the owner's label for a hand-written group.
  title String? @db.VarChar(500)

  lastFetchedAt DateTime?
  /// Owner-facing reason, never a raw fetch error (same rule as verification).
  failureReason String?   @db.VarChar(200)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items    KnowledgeItem[]

  /// One row per URL per business: a re-crawl updates rather than duplicating.
  @@unique([businessId, url])
  @@index([businessId, status, deletedAt])
  @@index([businessId, type])
  @@map("knowledge_sources")
}

/// One answerable unit. For a FAQ that is a question and its answer; for a page
/// it is a section heading and the text beneath it.
model KnowledgeItem {
  id         String @id @default(uuid()) @db.Uuid
  /// Denormalised from the source so every tenant-scoped query and the
  /// full-text index can filter without a join.
  businessId String @db.Uuid
  sourceId   String @db.Uuid

  /// The question, or the section heading. Null for an untitled chunk.
  question String? @db.VarChar(500)
  content  String  @db.Text

  /// True once the owner has changed it. A re-crawl must never overwrite a
  /// human correction - that would silently undo their work and is the fastest
  /// way to lose their trust in the whole feature.
  isEdited Boolean @default(false)

  /// Order within the source, so a page reads top to bottom.
  position Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([businessId, deletedAt])
  @@index([sourceId, position])
  @@map("knowledge_items")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.VarChar(255)
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  ipAddress        String?   @db.VarChar(45)
  userAgent        String?   @db.VarChar(512)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A single-use, time-limited proof that someone can read a user's email.
///
/// Only the SHA-256 of the token is stored. The raw token exists in the
/// user's inbox and nowhere else, so a database leak cannot be replayed into
/// account takeover - which is the whole risk this table carries, since a
/// valid row is by definition a way to become someone.
///
/// SHA-256 rather than bcrypt is deliberate: the token is 32 bytes of CSPRNG
/// output, so there is no dictionary to attack and no work factor worth
/// paying. Password hashing solves a problem this value does not have.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?   @db.VarChar(45)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// One question a visitor asked, and how well the receptionist handled it.
///
/// This is the product's feedback loop: the questions that came back
/// `unknown` are precisely the answers the owner should write next, and no
/// amount of guessing replaces seeing what people actually type.
///
/// ── What is deliberately NOT stored ──────────────────────────────────────
/// No IP address, no user agent, no cookie, nothing that identifies the
/// person asking. The owner needs to know WHAT was asked, never BY WHOM, and
/// storing the second would create an obligation that buys the product
/// nothing. `sessionKey` is a random per-conversation value generated in the
/// browser and never linked to anything else - enough to group one visit's
/// questions together, useless for tracking anyone across visits.
///
/// The question text itself is unavoidably visitor-authored free text, so it
/// is treated as such: shown to the owner escaped, never interpolated
/// anywhere, and swept after a retention window.
model ReceptionistQuestion {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  /// Truncated to the same limit the API accepts.
  question   String   @db.VarChar(500)
  /// answered | unsure | unknown - the honesty signal, and what makes the
  /// gap report possible.
  confidence String   @db.VarChar(16)
  /// The item that answered it, kept for "which answers earn their keep".
  /// Nulled rather than cascaded when an item is deleted, so history survives
  /// the owner tidying their knowledge base.
  itemId     String?  @db.Uuid
  /// Groups one visit's questions. Random, ephemeral, never linked to a person.
  sessionKey String   @db.VarChar(64)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([businessId, createdAt])
  /// Serves the gap report directly: the unanswered questions, newest first.
  @@index([businessId, confidence, createdAt])
  @@map("receptionist_questions")
}

model OnboardingProgress {
  id                    String    @id @default(uuid()) @db.Uuid
  businessId            String    @db.Uuid
  profileCompleted      Boolean   @default(false)
  profileCompletedAt    DateTime?
  firstDomainAdded      Boolean   @default(false)
  firstDomainAddedAt    DateTime?
  firstDomainVerified   Boolean   @default(false)
  firstDomainVerifiedAt DateTime?
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([businessId])
  @@map("onboarding_progress")
}
